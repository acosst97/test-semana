import { useEffect, useState, ChangeEvent } from 'react';
import { Post, User, PostsResponse, UsersResponse } from '../types/dummyjson';

export default function Blog() {
  // Inicializamos los estados con sus respectivos tipos de TypeScript
  const [posts, setPosts] = useState<Post[]>([]);
  const [users, setUsers] = useState<User[]>([]);
  const [selectedUser, setSelectedUser] = useState<string>('');
  const [activePost, setActivePost] = useState<Post | null>(null);

  useEffect(() => {
    // Traer posts y tipar la respuesta
    fetch('https://dummyjson.com/posts')
      .then((res) => res.json())
      .then((data: PostsResponse) => setPosts(data.posts))
      .catch((err) => console.error("Error cargando posts:", err));

    // Traer usuarios y tipar la respuesta
    fetch('https://dummyjson.com/users')
      .then((res) => res.json())
      .then((data: UsersResponse) => setUsers(data.users))
      .catch((err) => console.error("Error cargando usuarios:", err));
  }, []);

  // Buscamos el autor. Retorna un string.
  const getAuthorName = (userId: number): string => {
    const user = users.find((u) => u.id === userId);
    return user ? `${user.firstName} ${user.lastName}` : 'Autor Desconocido';
  };

  // Manejador del cambio de filtro con su tipo de evento correcto
  const handleUserChange = (e: ChangeEvent<HTMLSelectElement>) => {
    setSelectedUser(e.target.value);
  };

  // Filtrar los posts de forma segura
  const filteredPosts = selectedUser
    ? posts.filter((post) => post.userId === parseInt(selectedUser))
    : posts;

  return (
    <div style={{ display: 'flex', gap: '20px', padding: '20px', fontFamily: 'sans-serif' }}>
      
      {/* BARRA LATERAL */}
      <aside style={{ width: '250px' }}>
        <h3>Filtrar por Usuario</h3>
        <select value={selectedUser} onChange={handleUserChange}>
          <option value="">Todos los autores</option>
          {users.map((user) => (
            <option key={user.id} value={user.id}>
              {user.firstName} {user.lastName}
            </option>
          ))}
        </select>
      </aside>

      {/* LISTA DE POSTS */}
      <main style={{ flex: 1 }}>
        <h2>Publicaciones</h2>
        <div style={{ display: 'flex', flexDirection: 'column', gap: '15px' }}>
          {filteredPosts.map((post) => (
            <article key={post.id} style={{ border: '1px solid #ccc', padding: '15px', borderRadius: '8px' }}>
              <h3>{post.title}</h3>
              <p><small>Por: <strong>{getAuthorName(post.userId)}</strong></small></p>
              <p>{post.body.substring(0, 150)}...</p>
              
              <div style={{ marginBottom: '10px' }}>
                {post.tags.map((tag) => (
                  <span key={tag} style={{ background: '#eee', marginRight: '5px', padding: '3px 8px', borderRadius: '4px', fontSize: '12px' }}>
                    #{tag}
                  </span>
                ))}
              </div>

              <button onClick={() => setActivePost(post)}>Ver interacciones</button>
            </article>
          ))}
        </div>
      </main>

      {/* MODAL DE DETALLES */}
      {activePost && (
        <div style={{ position: 'fixed', top: 0, left: 0, width: '100%', height: '100%', backgroundColor: 'rgba(0,0,0,0.5)', display: 'flex', justifyContent: 'center', alignItems: 'center' }}>
          <div style={{ backgroundColor: 'white', padding: '20px', borderRadius: '8px', maxWidth: '400px', width: '100%' }}>
            <h2>{activePost.title}</h2>
            <hr />
            <p>👀 <strong>Vistas:</strong> {activePost.views}</p>
            <p>👍 <strong>Likes:</strong> {activePost.reactions.likes}</p>
            <p>👎 <strong>Dislikes:</strong> {activePost.reactions.dislikes}</p>
            <hr />
            <button onClick={() => setActivePost(null)}>Cerrar</button>
          </div>
        </div>
      )}
    </div>
  );
}